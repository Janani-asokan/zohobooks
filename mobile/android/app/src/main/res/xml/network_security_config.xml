<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, trusting only the phone's built-in certificate authorities (not ones a user installed). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
