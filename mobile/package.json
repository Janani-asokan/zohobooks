{
  "name": "corpuslite",
  "private": true,
  "version": "1.0.0",
  "description": "CorpusLite: the Corpus360 shop app for Android and iOS (Capacitor). The web part is built from the main app with `npm run build:app` in the repository root.",
  "scripts": {
    "web": "cd .. && npm run build:app",
    "sync": "cap sync",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
