{
  "name": "ledgerly-books",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --clear-screen=false server/src/index.ts",
    "build": "tsc -b && vite build && npm run build:api",
    "build:api": "esbuild server/src/index.ts --bundle --platform=node --target=node20 --packages=external --outfile=server/dist/index.js",
    "start": "NODE_ENV=production node server/dist/index.js",
    "db:migrate": "tsx server/src/migrate.ts",
    "db:seed": "tsx server/src/seed.ts",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/smoke.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@napi-rs/canvas": "^0.1.100",
    "@tanstack/react-query": "^5.62.11",
    "@tesseract.js-data/eng": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie": "^1.0.2",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.0",
    "helmet": "^8.0.0",
    "immer": "^10.1.1",
    "jsbarcode": "^3.11.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "nodemailer": "^6.9.16",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.13.1",
    "playwright-core": "1.56.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "tesseract.js": "^5.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.0.20",
    "@fontsource/poppins": "^5.0.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.24.2",
    "opentype.js": "^1.3.4",
    "playwright": "^1.56.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^2.1.8"
  }
}
