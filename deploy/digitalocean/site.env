# Public address of this server. Not secret, so it lives in Git: change it here, push, and the server applies it
# within 5 minutes. Values here override /opt/corpus360/.env.
#
# Never set a value to empty ("SITE_ADDRESS="): an empty but present variable is not the same as an unset one,
# and Caddy would get a site block without an address and refuse to start. Comment a line out instead.

# Caddy gets free Let's Encrypt certificates for these (the domain's DNS must point to this server).
SITE_ADDRESS=corpus360lite.com, www.corpus360lite.com
# The business's other domains: they send visitors to PRIMARY_HOST (their DNS must point to this server too).
REDIRECT_ADDRESSES=corpus360.in, www.corpus360.in, corpus360lite.in, www.corpus360lite.in
# www is redirected here.
PRIMARY_HOST=corpus360lite.com
# The app's public address: emails, shared invoice links, allowed browser origins.
APP_URL=https://corpus360lite.com
# The server's IP keeps working over plain http as a fallback (logins there use non-Secure cookies).
ALLOWED_ORIGINS=http://64.227.184.51
