# Public address of this server. Not secret, so it lives in Git: change it here, push, and the server applies it
# within 5 minutes. Values here override /opt/corpus360/.env.
#
# Leave these commented out until the domain's DNS points to the server: the site then runs on http://<server IP>.
# Never set them to an empty value ("SITE_ADDRESS="): an empty but present variable is not the same as an unset
# one, and Caddy would get a site block without an address and refuse to start.
#
# SITE_ADDRESS=corpus360.com, www.corpus360.com
# PRIMARY_HOST=corpus360.com
